# ── Database ─────────────────────────────────────────────────
# Untuk development lokal (Docker Compose):
DATABASE_URL="postgresql://pintar-sd:pintar-sd-123@localhost:5432/pintar-sd"
# Untuk production (Neon/Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pintar-sd?sslmode=require"

# ── Auth.js ───────────────────────────────────────────────────
# localhost untuk PC. Untuk tablet di Wi-Fi yang sama, biarkan AUTH_TRUST_HOST=true
# lalu buka http://IP-PC:3000 (jangan hardcode IP ke NEXTAUTH_URL).
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# ── LLM — Generate Soal ───────────────────────────────────────
LLM_PROVIDER="openai"           # openai | anthropic | google | openrouter | deepseek
LLM_MODEL="gpt-4o-mini"         # DeepSeek: deepseek-chat atau deepseek-reasoner
LLM_API_KEY="sk-..."
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"
# LLM_BASE_URL="https://openrouter.ai/api/v1"   # opsional, untuk OpenRouter
# DeepSeek (jika LLM_PROVIDER=deepseek, base URL diisi otomatis):
# LLM_PROVIDER="deepseek"
# LLM_MODEL="deepseek-chat"
# LLM_API_KEY="sk-..."   # dari https://platform.deepseek.com

# ── RAG — Embedding & Retrieval Kurikulum ────────────────────
RAG_ENABLED="true"              # set "false" untuk nonaktifkan RAG
RAG_TOP_K="4"                   # jumlah chunk kurikulum per query
EMBEDDING_PROVIDER="openai"     # openai | local
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY="sk-..."      # sama dengan LLM_API_KEY jika pakai OpenAI

# ── Storage (untuk fitur upload materi — V2) ─────────────────
# STORAGE_PROVIDER="vercel-blob"  # vercel-blob | s3 | supabase
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# ── Vision — baca tulisan stylus (lebih akurat dari Tesseract) ─
# DeepSeek chat-only, jadi kunci terpisah diperlukan.
# Rekomendasi: Gemini Flash, kunci di https://aistudio.google.com/apikey
# VISION_PROVIDER="google"
# VISION_MODEL="gemini-3.6-flash"
# VISION_API_KEY=""
# MAX_UPLOAD_SIZE_MB="20"
